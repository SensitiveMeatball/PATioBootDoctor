msgstr "W Dyskach i partycjach kliknij partycję i wybierz \"Odzyskaj usunięte pliki\"."

msgid "Deleted files on {0}"
msgstr "Usunięte pliki na {0}"

msgid " · full search"
msgstr " · pełne wyszukiwanie"

msgid " · quick search"
msgstr " · szybkie wyszukiwanie"

msgid "Save recovered files to a different drive, never to this one: writing here can overwrite the very files you want back."
msgstr "Zapisuj odzyskane pliki na innym dysku, nigdy na tym: zapis tutaj może nadpisać właśnie te pliki, które chcesz odzyskać."

msgid "Recover {0} files…"
msgstr "Odzyskaj pliki ({0})…"

msgid "Recover chosen files…"
msgstr "Odzyskaj wybrane pliki…"

msgid "Choose all shown"
msgstr "Wybierz wszystkie pokazane"

msgid "Choose none"
msgstr "Nie wybieraj żadnego"

msgid "Back to the disks"
msgstr "Wróć do dysków"

msgid "All"
msgstr "Wszystkie"

msgid "Pictures"
msgstr "Obrazy"

msgid "Documents"
msgstr "Dokumenty"

msgid "Music and videos"
msgstr "Muzyka i wideo"

msgid "Archives"
msgstr "Archiwa"

msgid "Other"
msgstr "Inne"

msgid "No files chosen"
msgstr "Nie wybrano plików"

