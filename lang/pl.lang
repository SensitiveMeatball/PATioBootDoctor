msgstr "Nie można przywrócić partycji. "

msgid "The partition could not be opened."
msgstr "Nie można otworzyć partycji."

msgid "This drive is locked by BitLocker. Unlock it first: its contents cannot be read while it is locked."
msgstr "Ten dysk jest zablokowany funkcją BitLocker. Najpierw go odblokuj: jego zawartości nie da się odczytać, dopóki jest zablokowany."

msgid "The file list of this drive is damaged. The full scan can still find files by their contents."
msgstr "Lista plików tego dysku jest uszkodzona. Pełne skanowanie nadal może znaleźć pliki po ich zawartości."

msgid "Reading the file list"
msgstr "Odczytywanie listy plików"

msgid "(folder unknown)"
msgstr "(nieznany folder)"

msgid "(folder unknown)\\"
msgstr "(nieznany folder)\\"

