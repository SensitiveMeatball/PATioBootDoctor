msgstr "Eksik: "

msgid "Damaged: "
msgstr "Bozuk: "

msgid "The Windows core and the drivers it needs to read its disk are in place."
msgstr "Windows çekirdeği ve diskini okumak için gereken sürücüler yerinde."

msgid "ntoskrnl.exe, hal.dll, ci.dll, ntfs.sys, disk.sys and others"
msgstr "ntoskrnl.exe, hal.dll, ci.dll, ntfs.sys, disk.sys ve diğerleri"

